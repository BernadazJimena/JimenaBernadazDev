{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jimenabernadazdev",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Los "me gusta" del blog y las respuestas de las preguntas frecuentes los responde el Worker; todo lo demás son archivos del sitio.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BLOG_LIKES", "class_name": "BlogLikes" },
      { "name": "FAQ_FEEDBACK", "class_name": "FaqFeedback" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BlogLikes"] },
    { "tag": "v2", "new_sqlite_classes": ["FaqFeedback"] }
  ]
}
